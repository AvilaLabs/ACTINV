+class InputACTINV(Input):
+    """Implementation of the Input class for ACTINV spec files.
+
+    The benchmark template folder is expected to contain a single ``*.json``
+    ACTINV spec (``actinv-spec-1``). ``catalog:`` references are left
+    untouched and resolved at run time through ``ACTINV_DATA_DIR``; a spec
+    carrying an explicit ``library.path`` file reference is repointed to the
+    selected library's activation bundle during :meth:`translate`.
+    """
+
+    def __init__(self, template_folder: PathLike, lib: LibraryACTINV):
+        for file in sorted(os.listdir(template_folder)):
+            if file.endswith(".json") and file not in ("metadata.json", "volumes.json"):
+                filepath = os.path.join(template_folder, file)
+                with open(filepath, encoding="utf-8") as f:
+                    spec = json.load(f)
+                if spec.get("spec") in ("actinv-spec-1", "actinv-mesh-spec-1"):
+                    break
+        else:
+            raise ConfigError(
+                f"No ACTINV spec (actinv-spec-1) found in {template_folder}"
+            )
+        self.template_folder = template_folder
+        self.spec = spec
+        self._name = file[:-5]
+        self._lib = lib
+
+    @property
+    def code(self) -> CODE:
+        return CODE.ACTINV
+
+    @property
+    def name(self) -> str:
+        return self._name
+
+    @property
+    def lib(self) -> LibraryACTINV:
+        return self._lib
+
+    def set_nps(self, nps: int):
+        # deterministic solver: no particle histories to set
+        self.nps = nps
+
+    def translate(self):
+        # An explicit file reference is repointed at the selected bundle;
+        # catalog: references already carry their own pin and are left alone.
+        lib_ref = self.spec.get("library", {})
+        path = lib_ref.get("path", "")
+        if path and not str(path).startswith("catalog:"):
+            activation = Path(self.lib.path, "activation")
+            bundles = sorted(activation.glob("*-neutron-709g.npz"))
+            if not bundles:
+                raise ConfigError(f"No activation bundle found under {activation}")
+            bundle = bundles[0]
+            lib_ref["path"] = str(bundle)
+            lib_ref["sha256"] = _sha256(bundle)
+
+        # The same for decay data references: repoint them at the bundle's
+        # decay directory so runs are independent of the original layout.
+        decay = self.spec.get("decay", {})
+        for key in ("primary", "fallback"):
+            ref = decay.get(key)
+            if ref and not str(ref).startswith("catalog:"):
+                candidate = Path(self.lib.path, "decay", Path(ref).name)
+                if candidate.exists():
+                    decay[key] = str(candidate)
+
+    def _write(self, output_folder: PathLike):
+        outfile = Path(output_folder, f"{self.name}.json")
+        with open(outfile, "w", encoding="utf-8") as f:
+            json.dump(self.spec, f, indent=2)
+            f.write("\n")
+
+
+def _sha256(path: PathLike) -> str:
+    import hashlib
+
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
