+import pytest
+
+from jade.config.run_config import LibraryACTINV
+from jade.helper.constants import CODE
+from jade.post.sim_output import ActinvSimOutput
+from jade.run.benchmark import SingleRunACTINV, SingleRunFactory
+from jade.run.input import InputACTINV
+
+
+@pytest.fixture()
+def bundle(tmp_path):
+    """Minimal ACTINV bundle layout: activation npz + index, decay dir."""
+    activation = tmp_path / "bundle" / "activation"
+    decay = tmp_path / "bundle" / "decay"
+    activation.mkdir(parents=True)
+    decay.mkdir(parents=True)
+    npz = activation / "test-neutron-709g.npz"
+    npz.write_bytes(b"fake-npz")
+    index = {
+        "schema": "actinv-library-index-2",
+        "targets": [{"za": 26056, "liso": 0}, {"za": 49115, "liso": 0}],
+    }
+    (activation / "test-neutron-709g_index.json").write_text(json.dumps(index))
+    (decay / "endf-b-viii-0_decay.dat").write_text("fake-decay")
+    return LibraryACTINV(name="test", path=tmp_path / "bundle")
+
+
+@pytest.fixture()
+def spec_folder(tmp_path):
+    """Template folder holding an actinv-spec-1 input."""
+    folder = tmp_path / "template"
+    folder.mkdir()
+    spec = {
+        "spec": "actinv-spec-1",
+        "title": "test",
+        "projectile": "neutron",
+        "library": {"path": "old/lib.npz"},
+        "decay": {"primary": "old/decay/endf-b-viii-0_decay.dat"},
+        "material": {
+            "mass_g": 1.0,
+            "basis": "wt_percent",
+            "composition": {"Fe": 100.0},
+        },
+        "flux": {"path": "flux.json", "sha256": "x"},
+        "schedule": [{"dt": "1 s", "flux": 1.0}],
+        "options": {"mode": "auto"},
+    }
+    (folder / "case1.json").write_text(json.dumps(spec))
+    return folder
+
+
+class TestLibraryACTINV:
+    def test_zaids(self, bundle):
+        assert bundle.get_lib_zaids() == ["26056", "49115"]
+
+
+class TestInputACTINV:
+    def test_translate_repoints_paths(self, bundle, spec_folder):
+        inp = InputACTINV(spec_folder, bundle)
+        assert inp.code == CODE.ACTINV
+        assert inp.name == "case1"
+        inp.translate()
+        lib_ref = inp.spec["library"]
+        assert str(bundle.path) in lib_ref["path"]
+        assert len(lib_ref["sha256"]) == 64
+        assert str(bundle.path) in inp.spec["decay"]["primary"]
+
+    def test_write(self, bundle, spec_folder, tmp_path):
+        inp = InputACTINV(spec_folder, bundle)
+        out = tmp_path / "out"
+        out.mkdir()
+        inp._write(out)
+        assert (out / "case1.json").exists()
+
+
+class TestSingleRunACTINV:
+    def test_build_command(self, bundle, spec_folder):
+        run = SingleRunFactory.create(CODE.ACTINV, spec_folder, bundle, 1)
+        assert isinstance(run, SingleRunACTINV)
+
+        from types import SimpleNamespace
+
+        cmd = run._build_command(
+            SimpleNamespace(executables={CODE.ACTINV: "actinv"})
+        )
+        assert cmd == ["actinv", "run", "case1.json", "result.json"]
+        name, value = run._get_lib_data_command()
+        assert name == "ACTINV_DATA_DIR"
+        assert value == str(Path(bundle.path).parent)
+
+
+class TestActinvSimOutput:
+    def test_parse(self, tmp_path):
+        result = {
+            "certificate": {"solver": "actinv-core 1.2.0"},
+            "steps": [
+                {
+                    "t_s": 10.0,
+                    "heat_W_per_g": {"total": 1e-6},
+                    "activity_Bq_per_g": {"Mn56": 1e7},
+                },
+                {
+                    "t_s": 20.0,
+                    "heat_W_per_g": {"total": 5e-7},
+                    "activity_Bq_per_g": {"Mn56": 5e6},
